  "hpp": "// HLS boundary using Waveflow-generated AXI stream types and serializers.\n#ifndef FIR_TOP_HPP\n#define FIR_TOP_HPP\n#include <ap_int.h>\n#include <hls_stream.h>\n#include \"../include/streamutils.h\"\nvoid fir(hls::stream<streamutils::axi4s_word<32>>& s_in,hls::stream<streamutils::axi4s_word<32>>& m_out,ap_uint<1>& halted,ap_uint<8>& error,ap_uint<32>& tx_id);\n#endif\n",
  "cpp": "// Standard Vitis host-activated adapter; arithmetic/protocol are in fir_body_impl.tpp.\n#include \"fir.hpp\"\n#include \"../fir_body_impl.tpp\"\nvoid fir(hls::stream<streamutils::axi4s_word<32>>& s_in,hls::stream<streamutils::axi4s_word<32>>& m_out,ap_uint<1>& halted,ap_uint<8>& error,ap_uint<32>& tx_id){\n#pragma HLS INTERFACE axis port=s_in\n#pragma HLS INTERFACE axis port=m_out\n#pragma HLS INTERFACE s_axilite port=halted bundle=control\n#pragma HLS INTERFACE s_axilite port=error bundle=control\n#pragma HLS INTERFACE s_axilite port=tx_id bundle=control\n#pragma HLS INTERFACE s_axilite port=return bundle=control\n    fir_impl::body<32,32>(s_in,m_out,halted,error,tx_id);\n}\n",
